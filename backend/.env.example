# Copy to backend/.env and fill in. See docs/setup.md.

# Any PostgreSQL database. Pick one (docs/setup.md, section 2):
# Neon (free, hosted). Keep ?sslmode=require:
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Postgres on this Mac (Homebrew):
# DATABASE_URL=postgresql://localhost:5432/aurea
# Cloud SQL through the Auth Proxy:
# DATABASE_URL=postgresql://aurea_app:PASSWORD@127.0.0.1:5432/aurea

# OAuth 2.0 Client ID (type: Web application) from Google Auth Platform > Clients
GOOGLE_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com

# Comma-separated origins allowed to call the API with cookies
ALLOWED_ORIGINS=http://localhost:5173

# Production over HTTPS: true. Keep false for http://localhost.
COOKIE_SECURE=false
# lax when the app and API share a site; none (with COOKIE_SECURE=true) when they do not.
COOKIE_SAMESITE=lax
SESSION_DAYS=30

# Local development only: shows "Continue as local developer" on the sign-in page.
# Only accepted from this machine. Never enable in production.
DEV_LOGIN=false

# Instagram publishing (optional). See docs/instagram.md.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Public HTTPS address of this API (a tunnel such as cloudflared or ngrok in development)
PUBLIC_API_URL=https://your-tunnel.trycloudflare.com
# Where the web app runs; defaults to the first ALLOWED_ORIGINS entry
APP_URL=http://localhost:5173
# Encrypts connected account tokens. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# During a key rotation: the old key, so existing tokens keep working until re-encrypted.
SECRET_KEY_PREVIOUS=

# ---- guardrails (docs/guardrails.md) ------------------------------------------------
# Daily limits per creator, reset at midnight UTC. A design is one finished carousel,
# poster, image, thumbnail, deck, or infographic.
DESIGNS_PER_DAY=5
RESEARCH_RUNS_PER_DAY=20
AI_ASSISTS_PER_DAY=100
CHAT_MESSAGES_PER_DAY=50
TREND_RUNS_PER_DAY=5
UPLOADS_PER_DAY=60
PUBLISHES_PER_DAY=10

# Conversation history kept per chat. Past this, the oldest messages are removed.
CONTEXT_WINDOW_TOKENS=200000
# Tokens the local model reads per call (Ollama num_ctx). qwen3:8b supports up to 32768;
# larger values use more memory.
LLM_NUM_CTX=8192
LLM_TIMEOUT_SECONDS=180
MAX_MODEL_CALLS_PER_RUN=24
RUN_DEADLINE_SECONDS=900
# Generations that may use the model at once (others wait in line).
MODEL_CONCURRENCY=1
QUEUE_TIMEOUT_SECONDS=600

# Semantic input validation: a model judges what each request means before any research
# or generation runs. On by default, using the main model. If the check cannot run, requests
# are refused unless SEMANTIC_GUARD_FAIL_OPEN=true.
SEMANTIC_GUARD=true
SEMANTIC_GUARD_MODEL=qwen3:8b
SEMANTIC_GUARD_FAIL_OPEN=false

# Optional local safety classifier: ollama pull llama-guard3:1b, then set it here.
GUARD_MODEL=

# Kill switches (also: uv run python -m guardrails.flags ai off)
AI_ENABLED=true
PUBLISHING_ENABLED=true

# Web research source filters (comma-separated domains)
BLOCKED_SOURCE_DOMAINS=pastebin.com,4chan.org,8kun.top,kiwifarms.net
PREFERRED_SOURCE_DOMAINS=reuters.com,apnews.com,bbc.com,nature.com,who.int,nih.gov,hbr.org,mckinsey.com,pewresearch.org,statista.com

# Retention in days
PIPELINE_RETENTION_DAYS=7
CHAT_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=90
